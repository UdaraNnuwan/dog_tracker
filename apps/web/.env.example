# Copy to .env.local (gitignored). Everything prefixed VITE_ is bundled into the public
# frontend, so only values that are safe to publish belong here (CLAUDE.md rule 1).
# No HiveMQ settings: the browser never talks to the broker.

# Supabase (Project Settings > API Keys). The publishable key (sb_publishable_…, formerly
# "anon") is public by design; RLS protects the data.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
