    },
    {
      "name": "Settings (spec V3 \u00a76)",
      "item": [
        {
          "name": "Set gps_settings",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/settings/gps_settings/set",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "devices",
                "{{deviceId}}",
                "settings",
                "gps_settings",
                "set"
              ]
            },
            "description": "Body: any fields of the group. Values may also be strings (\"60\", \"true\"); they are published as JSON numbers/booleans (ADR 0011). Invalid values return 400 before anything is published (rule 8). Completes when the collar ACKs on device/settings/ack/gps_settings.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gps_interval\": 60,\n  \"gps_enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get gps_settings",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/settings/gps_settings/get",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "devices",
                "{{deviceId}}",
                "settings",
                "gps_settings",
                "get"
              ]
            },
            "description": "The collar answers on backend/settings/response/gps_settings.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Set device_settings",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/settings/device_settings/set",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "devices",
                "{{deviceId}}",
                "settings",
                "gps_settings",
                "set"
              ]
            },
            "description": "Groups: network_settings, gps_settings, profile_settings, power_settings, sensor_settings, device_settings.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"audio_volume\": 60,\n  \"display_brightness\": 70,\n  \"geofence_alert_enable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
