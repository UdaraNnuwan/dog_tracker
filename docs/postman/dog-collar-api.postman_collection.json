              ],
              "path": [
                "api",
                "devices",
                "{{deviceId}}",
                "commands",
                "location"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Buzzer",
          "request": {
            "method": "POST",
            "header": [
              {
