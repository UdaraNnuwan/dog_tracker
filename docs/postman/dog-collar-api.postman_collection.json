{
  "info": {
    "name": "Smart Dog Collar API (dev)",
    "description": "Worker API for local development (`pnpm dev`, http://localhost:8787). Device commands go through the bridge, which validates them and publishes to `pettracker/{id}/device/\u2026` with a backend-generated request_id / setting_id (spec V3 \u00a74, \u00a76, ADR 0009, ADR 0011). Everything except /api/health needs LIVE_VIEW_UNAUTHENTICATED=true in apps/worker/.dev.vars and a localhost URL.\n\nTo publish raw MQTT messages (as a collar), see docs/postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8787"
    },
    {
      "key": "deviceId",
      "value": "dog001"
    }
  ],
  "item": [
    {
      "name": "Status",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Bridge and storage state. Public."
          }
        },
        {
          "name": "Devices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/devices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "devices"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Requests (commands sent)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests"
              ]
            },
            "description": "Recent command/settings requests and whether the collar answered."
          }
        }
      ]
    },
    {
      "name": "Commands (spec V3 \u00a74)",
      "item": [
        {
          "name": "Config",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/commands/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "devices",
                "{{deviceId}}",
                "commands",
                "config"
              ]
            },
            "description": "Config keys are not defined yet (TBD in spec V3).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"config\": {\n    \"tracking_enabled\": true,\n    \"report_interval_seconds\": 30\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Location",
          "request": {
            "method": "POST",
