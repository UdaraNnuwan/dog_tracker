{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/device/{device_id}/command/peripheral",
  "description": "Publisher QoS 1, retain false.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "protocol_version": {
      "type": "string"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "peripheral": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "timestamp",
    "request_id",
    "peripheral",
    "enabled"
  ],
  "examples": [
    {
      "timestamp": 1717330000,
      "request_id": "req_1005",
      "peripheral": "gps",
      "enabled": false
    }
  ]
}
