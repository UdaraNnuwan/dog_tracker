{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/device/command/sleep",
  "description": "Published by the backend, QoS 1, retain false. TBD in spec V3 (pilot phase).",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "action": {
      "default": "enter_sleep",
      "type": "string",
      "const": "enter_sleep"
    },
    "duration_seconds": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "s"
    }
  },
  "required": [
    "timestamp",
    "request_id",
    "action",
    "duration_seconds"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "timestamp": 1717330000,
      "request_id": "REQ_1003",
      "action": "enter_sleep",
      "duration_seconds": 600
    }
  ]
}
