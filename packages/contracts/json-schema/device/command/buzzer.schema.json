{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/device/command/buzzer",
  "description": "Published by the backend, QoS 1, retain false. TBD in spec V3 (pilot phase).",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "enabled": {
      "type": "boolean"
    },
    "duration_ms": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "ms"
    },
    "volume_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": [
    "timestamp",
    "request_id",
    "enabled",
    "duration_ms"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "timestamp": 1717330000,
      "request_id": "REQ_1003",
      "enabled": true,
      "duration_ms": 1500,
      "volume_percent": 70
    }
  ]
}
