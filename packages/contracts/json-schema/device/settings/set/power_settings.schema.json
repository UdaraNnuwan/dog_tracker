{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/device/settings/set/power_settings",
  "description": "Published by the backend, QoS 1, retain false.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "setting_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "setting_type": {
      "type": "string",
      "const": "power"
    },
    "action": {
      "type": "string",
      "const": "set"
    },
    "power_mode": {
      "type": "string"
    },
    "low_bat_thresh": {
      "description": "%",
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "low_bat_alert_enable": {
      "type": "boolean"
    },
    "inactive_timeout": {
      "description": "seconds",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "display_timeout": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "description": "seconds"
    },
    "display_brightness": {
      "description": "1..100",
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "timestamp",
    "setting_id",
    "setting_type",
    "action"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "timestamp": 1717330000,
      "action": "set",
      "setting_id": "set_1004",
      "setting_type": "power",
      "power_mode": "active",
      "low_bat_thresh": "20",
      "low_bat_alert_enable": "true",
      "inactive_timeout": "60",
      "display_timeout": "30",
      "display_brightness": "70"
    }
  ]
}
