{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/device/settings/set/network_settings",
  "description": "Published by the backend, QoS 1, retain false.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "setting_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "setting_type": {
      "type": "string",
      "const": "network"
    },
    "action": {
      "type": "string",
      "const": "set"
    },
    "mqtt_hb_interval": {
      "description": "seconds",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "mqtt_retry_interval": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "description": "seconds"
    },
    "telemetry_interval": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "description": "seconds"
    }
  },
  "required": [
    "timestamp",
    "setting_id",
    "setting_type",
    "action"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "timestamp": 1717330000,
      "action": "set",
      "setting_id": "set_1004",
      "setting_type": "network",
      "mqtt_hb_interval": "60",
      "mqtt_retry_interval": "60",
      "telemetry_interval": "60"
    }
  ]
}
