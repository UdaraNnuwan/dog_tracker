{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/device/settings/ack/profile_settings",
  "description": "Published by the collar, QoS 1, retain false.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "setting_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "setting_type": {
      "type": "string",
      "const": "profile"
    },
    "action": {
      "type": "string",
      "const": "ack"
    }
  },
  "required": [
    "timestamp",
    "setting_id",
    "setting_type",
    "action"
  ],
  "examples": [
    {
      "timestamp": 1717330000,
      "action": "ack",
      "setting_id": "set_1004",
      "setting_type": "profile"
    }
  ]
}
