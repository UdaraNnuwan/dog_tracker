{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/backend/status/connectivity",
  "description": "Published by the collar, QoS 1, retain true.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "offline"
      ]
    }
  },
  "required": [
    "status"
  ],
  "examples": [
    {
      "timestamp": 1717330000,
      "status": "online"
    },
    {
      "status": "offline"
    }
  ]
}
