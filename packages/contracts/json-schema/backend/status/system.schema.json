{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/backend/status/system",
  "description": "Published by the collar, QoS 0, retain false.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "firmware_version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.+-]+)?$"
    },
    "uptime_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "s"
    },
    "free_heap_bytes": {
      "description": "bytes",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reset_reason": {
      "type": "string"
    },
    "device_state": {
      "type": "string",
      "enum": [
        "active",
        "sleep",
        "idle"
      ]
    }
  },
  "required": [
    "timestamp",
    "firmware_version",
    "uptime_seconds",
    "device_state"
  ],
  "examples": [
    {
      "timestamp": 1717330000,
      "firmware_version": "1.0.0",
      "uptime_seconds": 86400,
      "free_heap_bytes": 185600,
      "reset_reason": "power_on",
      "device_state": "active"
    }
  ]
}
