{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/backend/response/location",
  "description": "Published by the collar, QoS 1, retain false.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999999999
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "const": "success"
        },
        "location": {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "accuracy_m": {
              "type": "number",
              "minimum": 0,
              "description": "m"
            },
            "fix_valid": {
              "type": "boolean"
            }
          },
          "required": [
            "latitude",
            "longitude",
            "accuracy_m",
            "fix_valid"
          ]
        }
      },
      "required": [
        "timestamp",
        "request_id",
        "status",
        "location"
      ]
    },
    {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999999999
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "const": "error"
        },
        "location": {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "accuracy_m": {
              "type": "number",
              "minimum": 0,
              "description": "m"
            },
            "fix_valid": {
              "type": "boolean"
            }
          },
          "required": [
            "latitude",
            "longitude",
            "accuracy_m",
            "fix_valid"
          ]
        }
      },
      "required": [
        "timestamp",
        "request_id",
        "status"
      ]
    }
  ],
  "examples": [
    {
      "timestamp": 1717330001,
      "request_id": "REQ_1003",
      "status": "success",
      "location": {
        "latitude": 6.9271,
        "longitude": 79.8612,
        "accuracy_m": 8.5,
        "fix_valid": true
      }
    }
  ]
}
