{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/backend/response/buzzer",
  "description": "Published by the collar, QoS 1, retain false. TBD in spec V3 (pilot phase).",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999999999
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "const": "success"
        },
        "enabled": {
          "type": "boolean"
        },
        "duration_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "ms"
        }
      },
      "required": [
        "timestamp",
        "request_id",
        "status",
        "enabled",
        "duration_ms"
      ]
    },
    {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999999999
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "const": "error"
        },
        "enabled": {
          "type": "boolean"
        },
        "duration_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "ms"
        }
      },
      "required": [
        "timestamp",
        "request_id",
        "status"
      ]
    }
  ],
  "examples": [
    {
      "timestamp": 1717330001,
      "request_id": "REQ_1003",
      "status": "success",
      "enabled": true,
      "duration_ms": 1500
    }
  ]
}
