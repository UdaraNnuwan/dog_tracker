{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/backend/response/config",
  "description": "Published by the collar, QoS 1, retain false. TBD in spec V3 (pilot phase).",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999999999
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "const": "success"
        },
        "applied": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "timestamp",
        "request_id",
        "status",
        "applied"
      ]
    },
    {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999999999
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "const": "error"
        },
        "applied": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "timestamp",
        "request_id",
        "status"
      ]
    }
  ],
  "examples": [
    {
      "timestamp": 1717330001,
      "request_id": "REQ_1003",
      "status": "success",
      "applied": {
        "tracking_enabled": true,
        "report_interval_seconds": 30
      }
    }
  ]
}
