{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/backend/response/peripheral",
  "description": "Published by the collar, QoS 1, retain false.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999999999
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "const": "success"
        },
        "peripheral": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "timestamp",
        "request_id",
        "status",
        "peripheral",
        "enabled"
      ]
    },
    {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999999999
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "const": "error"
        },
        "peripheral": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "timestamp",
        "request_id",
        "status"
      ]
    }
  ],
  "examples": [
    {
      "timestamp": 1717330001,
      "request_id": "REQ_1003",
      "status": "success",
      "peripheral": "speaker",
      "enabled": false
    }
  ]
}
