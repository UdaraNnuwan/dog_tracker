{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/backend/response/reboot",
  "description": "Published by the collar, QoS 1, retain false. TBD in spec V3 (pilot phase).",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected"
      ]
    }
  },
  "required": [
    "timestamp",
    "request_id",
    "status"
  ],
  "examples": [
    {
      "timestamp": 1717330001,
      "request_id": "REQ_1003",
      "status": "accepted"
    }
  ]
}
