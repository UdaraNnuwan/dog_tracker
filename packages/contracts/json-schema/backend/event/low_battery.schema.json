{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/backend/event/low_battery",
  "description": "Published by the collar, QoS 1, retain false.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "percentage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "voltage": {
      "type": "number",
      "minimum": 0,
      "description": "V"
    },
    "threshold_percentage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "charging": {
      "type": "boolean"
    }
  },
  "required": [
    "timestamp",
    "percentage",
    "voltage",
    "threshold_percentage"
  ],
  "examples": [
    {
      "timestamp": 1717330000,
      "percentage": 14,
      "voltage": 3.55,
      "threshold_percentage": 15,
      "charging": false
    }
  ]
}
