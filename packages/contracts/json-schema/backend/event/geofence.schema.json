{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/backend/event/geofence",
  "description": "Published by the collar, QoS 1, retain false. TBD in spec V3 (pilot phase).",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "in_status": {
      "type": "boolean"
    },
    "out_status": {
      "type": "boolean"
    }
  },
  "required": [
    "timestamp",
    "in_status",
    "out_status"
  ],
  "examples": [
    {
      "timestamp": 1717330000,
      "in_status": true,
      "out_status": false
    }
  ]
}
