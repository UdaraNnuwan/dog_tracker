{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/backend/diagnostic/log",
  "description": "Published by the collar, QoS 0, retain false.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "error_type": {
      "type": "string"
    },
    "error_code": {
      "type": "string",
      "description": "numeric or alphanumeric"
    }
  },
  "required": [
    "timestamp",
    "error_type",
    "error_code"
  ],
  "examples": [
    {
      "timestamp": 1717330000,
      "error_type": "eeprom",
      "error_code": "400004"
    }
  ]
}
