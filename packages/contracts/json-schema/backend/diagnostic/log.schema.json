{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/backend/{device_id}/diagnostic/log",
  "description": "Publisher QoS 0, retain false.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "protocol_version": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "error_type": {
      "type": "string"
    },
    "error_code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "timestamp"
  ],
  "examples": [
    {
      "timestamp": 1717330000,
      "level": "error",
      "module": "storage",
      "error_type": "eeprom",
      "error_code": "400004"
    }
  ]
}
