{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/backend/diagnostic/debug_log",
  "description": "Published by the collar, QoS 0, retain false.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "level": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "module": {
      "type": "string"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "timestamp",
    "level",
    "module",
    "message"
  ],
  "examples": [
    {
      "timestamp": 1717330000,
      "level": "info",
      "module": "gps",
      "message": "GNSS fix acquired"
    }
  ]
}
