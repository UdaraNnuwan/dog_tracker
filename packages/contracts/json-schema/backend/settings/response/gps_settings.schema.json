{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/backend/settings/response/gps_settings",
  "description": "Published by the collar, QoS 1, retain false.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "setting_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "setting_type": {
      "type": "string",
      "const": "gps"
    },
    "action": {
      "type": "string",
      "enum": [
        "get_response",
        "set"
      ]
    },
    "gps_interval": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^-?\\d+$"
        }
      ],
      "description": "seconds"
    },
    "gps_enabled": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        }
      ]
    }
  },
  "required": [
    "timestamp",
    "setting_id",
    "setting_type",
    "action"
  ],
  "examples": [
    {
      "timestamp": 1717330000,
      "action": "get_response",
      "setting_id": "set_1003",
      "setting_type": "gps",
      "gps_interval": "60",
      "gps_enabled": "true"
    }
  ]
}
