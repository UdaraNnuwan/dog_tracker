{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/backend/settings/response/device_settings",
  "description": "Published by the collar, QoS 1, retain false.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "setting_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "setting_type": {
      "type": "string",
      "const": "device"
    },
    "action": {
      "type": "string",
      "enum": [
        "get_response",
        "set"
      ]
    },
    "pwrkey_hold_timeout": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^-?\\d+$"
        }
      ],
      "description": "seconds"
    },
    "speaker_enable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        }
      ]
    },
    "audio_volume": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        {
          "type": "string",
          "pattern": "^-?\\d+$"
        }
      ],
      "description": "1..100"
    },
    "audio_sample_rate": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^-?\\d+$"
        }
      ],
      "description": "milliseconds"
    },
    "display_enable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        }
      ]
    },
    "display_rotation": {
      "description": "0 = portrait, 2 = portrait rotated 180°",
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^-?\\d+$"
        }
      ]
    },
    "display_inverted": {
      "description": "true = white on black",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        }
      ]
    },
    "display_timeout": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^-?\\d+$"
        }
      ],
      "description": "seconds"
    },
    "display_brightness": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        {
          "type": "string",
          "pattern": "^-?\\d+$"
        }
      ],
      "description": "1..100"
    },
    "geofence_alert_enable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        }
      ]
    },
    "motion_alert_enable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        }
      ]
    },
    "high_temp_alert_enable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        }
      ]
    }
  },
  "required": [
    "timestamp",
    "setting_id",
    "setting_type",
    "action"
  ],
  "examples": [
    {
      "timestamp": 1717330000,
      "action": "get_response",
      "setting_id": "set_1003",
      "setting_type": "device",
      "pwrkey_hold_timeout": "60",
      "speaker_enable": "true",
      "audio_volume": "60",
      "audio_sample_rate": "60",
      "display_enable": "true",
      "display_rotation": "0",
      "display_inverted": "false",
      "display_timeout": "60",
      "display_brightness": "60",
      "geofence_alert_enable": "true",
      "motion_alert_enable": "true",
      "high_temp_alert_enable": "true"
    }
  ]
}
