{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/backend/settings/response/profile_settings",
  "description": "Published by the collar, QoS 1, retain false.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "setting_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "setting_type": {
      "type": "string",
      "const": "profile"
    },
    "action": {
      "type": "string",
      "enum": [
        "get_response",
        "set"
      ]
    },
    "pet_name": {
      "type": "string",
      "minLength": 1
    },
    "owner_qr": {
      "type": "string"
    },
    "vaccination_status": {
      "description": "0, 1, 2",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        {
          "type": "string",
          "pattern": "^-?\\d+$"
        }
      ]
    },
    "next_vacc_due": {
      "type": "string"
    },
    "vaccines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "completed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "true",
                  "false"
                ]
              }
            ]
          }
        },
        "required": [
          "name",
          "date",
          "completed"
        ]
      }
    }
  },
  "required": [
    "timestamp",
    "setting_id",
    "setting_type",
    "action",
    "pet_name"
  ],
  "examples": [
    {
      "timestamp": 1717330000,
      "action": "get_response",
      "setting_id": "set_1003",
      "setting_type": "profile",
      "pet_name": "shadow",
      "owner_qr": "https://example.com/owner/shadow",
      "vaccination_status": "1",
      "next_vacc_due": "2027-01-01",
      "vaccines": [
        {
          "name": "rabies",
          "date": "2028-01-01",
          "completed": "true"
        },
        {
          "name": "distemper",
          "date": "2028-01-01",
          "completed": "true"
        },
        {
          "name": "parvovirus",
          "date": "2028-01-01",
          "completed": "true"
        }
      ]
    }
  ]
}
