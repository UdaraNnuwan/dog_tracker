{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/backend/telemetry/gps",
  "description": "Published by the collar, QoS 0, retain false.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "speed": {
      "type": "number",
      "minimum": 0,
      "description": "m/s"
    }
  },
  "required": [
    "timestamp",
    "latitude",
    "longitude",
    "speed"
  ],
  "examples": [
    {
      "timestamp": 1717330000,
      "latitude": 6.9271,
      "longitude": 79.8612,
      "speed": 1.2
    }
  ]
}
