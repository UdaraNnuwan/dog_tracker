{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/backend/{device_id}/telemetry/gps",
  "description": "Publisher QoS 0, retain false.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "protocol_version": {
      "type": "string"
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "speed": {
      "description": "m/s",
      "type": "number",
      "minimum": 0
    },
    "accuracy": {
      "description": "m, horizontal",
      "type": "number",
      "minimum": 0
    },
    "satellites": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "timestamp",
    "latitude",
    "longitude"
  ],
  "examples": [
    {
      "timestamp": 1717330000,
      "latitude": 6.9271,
      "longitude": 79.8612,
      "speed": 1.2,
      "accuracy": 4.5,
      "satellites": 10
    }
  ]
}
