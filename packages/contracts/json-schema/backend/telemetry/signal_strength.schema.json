{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/backend/telemetry/signal_strength",
  "description": "Published by the collar, QoS 0, retain false.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "strength_lower_limit": {
      "type": "number"
    },
    "strength_upper_limit": {
      "type": "number"
    }
  },
  "required": [
    "timestamp",
    "strength_lower_limit",
    "strength_upper_limit"
  ],
  "examples": [
    {
      "timestamp": 1717330000,
      "strength_lower_limit": 50,
      "strength_upper_limit": 79
    }
  ]
}
