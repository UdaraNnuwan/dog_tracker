{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pettracker/{device_id}/backend/telemetry/imu",
  "description": "Published by the collar, QoS 0, retain false.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999
    },
    "acceleration": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "description": "m/s^2"
    },
    "gyroscope": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "description": "deg/s"
    }
  },
  "required": [
    "timestamp",
    "acceleration",
    "gyroscope"
  ],
  "examples": [
    {
      "timestamp": 1717330000,
      "acceleration": {
        "x": 0.02,
        "y": -0.1,
        "z": 9.79
      },
      "gyroscope": {
        "x": 0.3,
        "y": -0.1,
        "z": 0
      }
    }
  ]
}
